{
  "name": "@unbox-plus/cli",
  "version": "0.31.1",
  "author": {
    "name": "Unbox Development Team",
    "email": "devs@unbox.com.br",
    "url": "https://unbox.com.br"
  },
  "description": "Unbox stores CLI: scaffold a Next.js storefront from the official template and talk to the Partners API",
  "keywords": [
    "unbox",
    "storefront",
    "ecommerce"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "bin": {
    "unbox": "./bin/unbox.js",
    "create-unbox-store": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "template",
    "MIGRACAO.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@next/env": "15.5.24",
    "@unbox-plus/sdk": "^0.5.0",
    "prompts": "^2.4.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unbox-plus/unbox-cli.git"
  },
  "bugs": {
    "url": "https://github.com/unbox-plus/unbox-cli/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check:neutro": "node tools/check-template-neutro.mjs",
    "release": "node tools/github-release.mjs",
    "check:migracao": "node tools/check-migracao.mjs",
    "prepack": "node tools/check-template-neutro.mjs && node tools/check-migracao.mjs && node tools/sync-skills.mjs --check",
    "check:skills": "node tools/sync-skills.mjs --check",
    "sync:skills": "node tools/sync-skills.mjs"
  }
}
