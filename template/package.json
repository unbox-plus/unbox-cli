{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-unbox-brand.mjs && node scripts/medir-sistema.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "unbox:test": "tsx scripts/test-live.ts",
    "unbox:dump": "tsx scripts/dump-catalog.ts",
    "unbox:honestidade": "node scripts/check-honestidade.mjs",
    "unbox:receita": "node scripts/check-recipe.mjs",
    "unbox:webhook:subscribe": "tsx scripts/subscribe-webhook.ts",
    "unbox:order:pix": "tsx scripts/place-order-pix.ts",
    "unbox:abandoned": "tsx scripts/abandoned-cart.ts",
    "unbox:qa": "node scripts/qa-screenshots.mjs",
    "unbox:sistema": "python3 scripts/sistema.py .",
    "unbox:vocabulario": "python3 scripts/vocabulario.py .",
    "unbox:medir": "node scripts/medir-sistema.mjs",
    "unbox:placeholder": "node scripts/check-placeholder.mjs",
    "unbox:editavel": "node scripts/check-editable.mjs --url ${UNBOX_URL:-http://localhost:3000}"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.12",
    "next": "15.5.19",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "^2.17.5",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/env": "15.5.19",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.19",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
